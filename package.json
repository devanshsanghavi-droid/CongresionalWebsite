{
  "name": "carta-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Public website and web version of Carta, a Congressional App Challenge 2026 entry (CA-16).",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p src/carta/extraction/tsconfig.json",
    "build": "node scripts/copy-ocr-assets.mjs && npm run typecheck && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/copy-ocr-assets.mjs",
    "test": "vitest run",
    "sync": "node scripts/sync-from-carta.mjs",
    "ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "measure:tesseract": "node --experimental-strip-types scripts/measure-tesseract.mts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
